complete -c zon2tct -n '__fish_seen_subcommand_from init' -l name -r -d 'specify project name for template file'

# completion
complete -c zon2tct -n '__fish_seen_subcommand_from completion' -s h -l help -d 'print this help and exit'
complete -c zon2tct -n '__fish_seen_subcommand_from completion' -a 'bash fish zsh'
